#!/bin/zsh
set -euo pipefail

resources_dir="${0:A:h}/Resources"
console_user="$(/usr/bin/stat -f '%Su' /dev/console)"

if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
    echo "Tahoe Update Badge Blocker requires a signed-in macOS user." >&2
    exit 1
fi

user_uid="$(/usr/bin/id -u "$console_user")"
user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/awk '{print $2}')"
app_support_dir="$user_home/Library/Application Support/HideSystemSettingsBadge"
preference_panes_dir="$user_home/Library/PreferencePanes"
launch_agents_dir="$user_home/Library/LaunchAgents"
helper_path="$app_support_dir/hide-badge.sh"
preference_tool_path="$app_support_dir/badge-preference-tool"
agent_path="$launch_agents_dir/com.cagatay.hide-system-settings-badge.plist"
lock_agent_path="$launch_agents_dir/com.cagatay.badgehider-screen-lock.plist"
prefpane_path="$preference_panes_dir/Tahoe Update Badge Blocker.prefPane"

/bin/mkdir -p "$app_support_dir/lib" "$preference_panes_dir" "$launch_agents_dir"

/bin/cp "$resources_dir/Scripts/hide-badge.sh" "$helper_path"
/bin/cp "$resources_dir/Scripts/lib/classify-updates.sh" "$app_support_dir/lib/classify-updates.sh"
/bin/cp "$resources_dir/build/BadgePreferenceTool" "$preference_tool_path"
/bin/cp "$resources_dir/Scripts/uninstall.sh" "$app_support_dir/uninstall.sh"
/bin/chmod 755 "$helper_path" "$preference_tool_path" "$app_support_dir/uninstall.sh"

/bin/rm -rf "$prefpane_path" \
    "$preference_panes_dir/Tahoe Badge Filter.prefPane" \
    "$preference_panes_dir/Rozet Gizleyici.prefPane"
/usr/bin/ditto "$resources_dir/build/BadgePreferencePane.prefPane" "$prefpane_path"

/usr/bin/sed "s|__HELPER_PATH__|$helper_path|g" \
    "$resources_dir/LaunchAgents/com.cagatay.hide-system-settings-badge.plist" > "$agent_path"
/bin/chown -R "$console_user":staff "$app_support_dir" "$preference_panes_dir" "$agent_path"
/usr/bin/plutil -lint "$agent_path"

run_as_user() {
    /bin/launchctl asuser "$user_uid" /usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" "$@"
}

if ! run_as_user /usr/bin/defaults read com.cagatay.BadgeHider Enabled >/dev/null 2>&1; then
    run_as_user /usr/bin/defaults write com.cagatay.BadgeHider Enabled -bool true
fi

/bin/launchctl bootout "gui/$user_uid" "$agent_path" 2>/dev/null || true
/bin/launchctl bootout "gui/$user_uid" "$lock_agent_path" 2>/dev/null || true
/bin/rm -f "$lock_agent_path" "$app_support_dir/screen-lock-listener"
/bin/launchctl bootstrap "gui/$user_uid" "$agent_path"
run_as_user /usr/bin/defaults delete com.cagatay.BadgeHider PendingDockRefresh 2>/dev/null || true

echo "Installed Tahoe Update Badge Blocker for $console_user."
exit 0
